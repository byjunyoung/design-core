{
  "name": "design-core",
  "version": "0.1.3",
  "description": "A design tool for product screens where the agent holds the pen: screens as YAML, lint, states, proposals, a live viewer, MCP.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Junyoung Kim",
    "url": "https://github.com/byjunyoung"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/byjunyoung/design-core.git"
  },
  "homepage": "https://github.com/byjunyoung/design-core#readme",
  "bugs": {
    "url": "https://github.com/byjunyoung/design-core/issues"
  },
  "keywords": [
    "design",
    "design-tool",
    "agent",
    "mcp",
    "figma",
    "lint",
    "yaml",
    "ux",
    "handoff"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "design-core": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "schema",
    "conventions.example.yaml",
    "README.md",
    "DESIGN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "npm test && node src/cli.js lint examples/orders --branch feature/demo && node src/cli.js lint examples/store-ops --branch feature/demo && node src/cli.js render examples/store-ops --out /tmp/design-core-check --branch feature/demo",
    "demo": "node src/cli.js serve examples/store-ops --components antd --branch feature/demo",
    "start": "node src/cli.js serve design"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "yaml": "^2.6.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "antd": "^6.6.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
